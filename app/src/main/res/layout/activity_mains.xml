<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/launcher_main_screen" android:background="@drawable/launcher_login_back" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <VideoView android:id="@+id/videoView" android:layout_width="fill_parent" android:layout_height="fill_parent" />

    <androidx.appcompat.widget.AppCompatImageView android:layout_width="fill_parent" android:layout_height="fill_parent" android:src="@drawable/launcher_main_back" android:scaleType="fitXY" android:alpha="0.9" />

    <ProgressBar
        android:id="@+id/progress_bar2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateDrawable="@drawable/progressbar_custom"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="fitXY"
        android:src="@drawable/launcher_main_front" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/right_back"
        android:layout_width="405dp"
        android:layout_height="410dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:layout_constraintWidth_percent="0.45"
        app:srcCompat="@drawable/launcher_start_game" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/left_menu_button"
        android:layout_width="233dp"
        android:layout_height="183dp"
        android:layout_marginBottom="28dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintHorizontal_bias="0.082"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.55"
        app:srcCompat="@drawable/launcher_main_menu" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/donate_button"
        android:layout_width="@dimen/_83sdp"
        android:layout_height="@dimen/_23sdp"
        app:srcCompat="@drawable/launcher_main_grand_add"
        tools:layout_editor_absoluteX="254dp"
        tools:layout_editor_absoluteY="45dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_settings"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:background="@drawable/launcher_main_settings"
        app:layout_constraintBottom_toBottomOf="@+id/right_back"
        app:layout_constraintEnd_toEndOf="@+id/right_back"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/right_back"
        app:layout_constraintTop_toTopOf="@+id/right_back"
        app:layout_constraintVertical_bias="0.118" />

    <TextView android:textSize="@dimen/_10sdp" android:textColor="@color/black" android:id="@+id/online_help" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/_45sdp" android:text="СЕЙЧАС\nОНЛАЙН" android:fontFamily="@font/akrobat_bold" android:layout_marginEnd="@dimen/_80sdp" android:letterSpacing="0.2" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/online_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_7sdp"
        android:fontFamily="@font/akrobat_bold"
        android:gravity="center"
        android:text="40"
        android:textColor="@color/black"
        android:textSize="@dimen/_20sdp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/online_help"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/online_help"
        app:layout_constraintTop_toBottomOf="@+id/online_help" />
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/coupon_image" android:visibility="visible" android:layout_width="@dimen/_45sdp" android:layout_height="@dimen/_14sdp" android:layout_marginStart="@dimen/_69sdp" app:layout_constraintBottom_toTopOf="@+id/donate_button" app:layout_constraintEnd_toStartOf="@+id/button_settings" app:layout_constraintHorizontal_bias="0.0" app:layout_constraintStart_toStartOf="@+id/donate_button" app:layout_constraintTop_toTopOf="@+id/donate_button" app:srcCompat="@drawable/launcher_coupon" />


    <ImageButton
        android:id="@+id/ib_info"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="56dp"
        android:background="@drawable/launcher_red_buttons_bg"
        android:contentDescription="info"
        android:src="@drawable/launcher_main_info_ic"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/text_view_info_about_nickname"
        app:layout_constraintEnd_toStartOf="@+id/donate_button"
        app:layout_constraintHorizontal_bias="0.562"
        app:layout_constraintStart_toEndOf="@+id/edittextname"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.75" />

    <TextView
        android:id="@+id/text_view_info_about_nickname"
        android:layout_width="231dp"
        android:layout_height="94dp"
        android:layout_marginTop="8.0dip"
        android:layout_marginBottom="28dp"
        android:background="@drawable/launcher_main_info_bg"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:paddingStart="8.0dip"
        android:paddingEnd="8.0dip"
        android:text="• формат ввода: Nick_Name\n• допустимая длина никнейма 3-23 символов\n• в никнейме запрещены оскорбительные\nи нецензурные слова\n• никнейм должен содержать только латиницу\n• запрещено использование цифр и символов"
        android:textColor="@color/white"
        android:textSize="10.0sp"
        android:textStyle="italic"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/left_menu_button"
        app:layout_constraintEnd_toEndOf="@+id/donate_button"
        app:layout_constraintStart_toStartOf="@id/ib_info"
        app:layout_constraintTop_toBottomOf="@id/ib_info" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_play"
        android:layout_width="175dp"
        android:layout_height="63dp"
        android:background="#00FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/right_back"
        app:layout_constraintEnd_toEndOf="@+id/videoView"
        app:layout_constraintHorizontal_bias="0.826"
        app:layout_constraintStart_toStartOf="@+id/right_back"
        app:layout_constraintTop_toTopOf="@+id/right_back"
        app:layout_constraintVertical_bias="0.887" />
</androidx.constraintlayout.widget.ConstraintLayout>