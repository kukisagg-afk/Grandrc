<?xml version="1.0" encoding="utf-8"?>


<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
>

    <VideoView
        android:id="@+id/videoView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageView18"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:alpha="0.8"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintHorizontal_bias="0.64"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5"
        app:srcCompat="@drawable/launcher_coupon_time" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageView3"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="fitXY"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.6"
        app:layout_constraintHorizontal_bias="0.64"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5"
        app:srcCompat="@drawable/launcher_donate_bottom_en_pistol" />

    <TextView
        android:id="@+id/select_character_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20sdp"
        android:fontFamily="@font/akrobat_bold"
        android:gravity="center"
        android:text="МАГАЗИН"
        android:textColor="@color/white"
        android:textSize="@dimen/_23sdp"
        app:layout_constraintBottom_toBottomOf="@+id/donate_back_button"
        app:layout_constraintStart_toEndOf="@+id/donate_back_button"
        app:layout_constraintTop_toTopOf="@+id/donate_back_button"
        app:layout_constraintVertical_bias="1.0" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/donate_back_button"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_15sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/launcher_login_back_button" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/donate_progress_main"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.19"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="1.0"
        app:srcCompat="@drawable/launcher_donate_bottom_en_clip" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/donate_progress_main_back"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.19"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="1.0"
        app:srcCompat="@drawable/launcher_donate_bottom_dis_clip" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/donate_progress_gradient"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="1.0"
        app:srcCompat="@drawable/launcher_donate_bottom_en_blur_clip" />

    <TextView
        android:id="@+id/donate_shop_help"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_15sdp"
        android:fontFamily="@font/akrobat_semi_bold"
        android:text="Вы сможете потратить донат валюту\nна любом игровом сервере"
        android:textColor="#ffffd634"
        android:textSize="@dimen/_9sdp"
        app:layout_constraintBottom_toBottomOf="@+id/select_character_header"
        app:layout_constraintStart_toEndOf="@+id/select_character_header"
        app:layout_constraintTop_toTopOf="@+id/select_character_header"
        app:layout_constraintVertical_bias="0.5" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/donate_edit_back"
        android:layout_width="@dimen/_180sdp"
        android:layout_height="@dimen/_40sdp"
        app:layout_constraintBottom_toTopOf="@+id/donate_progress_gradient"
        app:layout_constraintStart_toStartOf="@+id/donate_back_button"
        app:layout_constraintTop_toBottomOf="@+id/select_character_header"
        app:srcCompat="@drawable/launcher_donate_input_back_left" />

    <TextView
        android:id="@+id/summ"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_5sdp"
        android:alpha="0.4"
        android:text="СУММА ПОПОЛНЕНИЯ"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/donate_edit_back"
        app:layout_constraintStart_toStartOf="@+id/donate_edit_back" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/deposit"
        android:layout_width="@dimen/_130sdp"
        android:layout_height="@dimen/_40sdp"
        android:layout_marginStart="-30.0dip"
        app:layout_constraintBottom_toBottomOf="@+id/donate_edit_back"
        app:layout_constraintStart_toEndOf="@+id/donate_edit_back"
        app:layout_constraintTop_toTopOf="@+id/donate_edit_back"
        app:srcCompat="@drawable/launcher_donate_input_back_right" />

    <EditText
        android:id="@+id/sum"
        android:layout_width="@dimen/_140sdp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:background="@null"
        android:digits="\ 0123456789"
        android:fontFamily="@font/akrobat_semi_bold"
        android:gravity="center"
        android:imeOptions="actionDone|flagNoExtractUi"
        android:inputType="numberDecimal"
        android:maxLength="16"
        android:text="0 РУБ."
        android:textColor="@color/white"
        android:textSize="@dimen/_20sdp"
        app:layout_constraintBottom_toBottomOf="@+id/donate_edit_back"
        app:layout_constraintEnd_toStartOf="@+id/deposit"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/donate_edit_back"
        app:layout_constraintTop_toTopOf="@+id/donate_edit_back"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/donate_help_image"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="40dp"
        android:clickable="true"
        android:scaleType="fitXY"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.95"
        app:srcCompat="@drawable/launcher_donate_front" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/donate_help_button"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:background="#00FFFFFF"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.23"
        app:layout_constraintHorizontal_bias="0.974"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.078"
        app:layout_constraintWidth_percent="0.3"
        app:srcCompat="@drawable/launcher_donate_help_icon" />

</androidx.constraintlayout.widget.ConstraintLayout>