<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root" android:focusable="true" android:focusableInTouchMode="true" android:layout_width="fill_parent" android:layout_height="fill_parent">

  <VideoView
      android:id="@+id/videoView"
      android:layout_width="fill_parent"
      android:layout_height="fill_parent"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <androidx.appcompat.widget.AppCompatImageView
      android:id="@+id/appCompatImageView3"
      android:layout_width="fill_parent"
      android:layout_height="fill_parent"
      android:alpha="0.9"
      android:scaleType="fitXY"
      android:src="@drawable/launcher_main_back" />

  <androidx.appcompat.widget.AppCompatImageView
      android:id="@+id/appCompatImageView4"
      android:layout_width="fill_parent"
      android:layout_height="fill_parent"
      android:scaleType="fitXY"
      android:src="@drawable/launcher_main_front" />

  <androidx.appcompat.widget.AppCompatImageView
      android:id="@+id/left_menu_button2"
      android:layout_width="233dp"
      android:layout_height="183dp"
      android:scaleType="fitXY"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHeight_percent="0.5"
      app:layout_constraintHorizontal_bias="0.129"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.929"
      app:layout_constraintWidth_percent="0.55"
      app:srcCompat="@drawable/launcher_main_menu" />

  <androidx.appcompat.widget.AppCompatImageView
      android:id="@+id/donate_button"
      android:layout_width="@dimen/_83sdp"
      android:layout_height="@dimen/_23sdp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toStartOf="@+id/button_settings"
      app:layout_constraintHorizontal_bias="0.697"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.118"
      app:srcCompat="@drawable/launcher_main_grand_add" />

  <androidx.appcompat.widget.AppCompatImageView
      android:id="@+id/coupon_image3"
      android:layout_width="@dimen/_45sdp"
      android:layout_height="@dimen/_14sdp"
      android:layout_marginStart="@dimen/_69sdp"
      android:visibility="visible"
      app:layout_constraintBottom_toTopOf="@+id/donate_button"
      app:layout_constraintEnd_toStartOf="@+id/button_settings"
      app:layout_constraintHorizontal_bias="0.0"
      app:layout_constraintStart_toStartOf="@+id/donate_button"
      app:layout_constraintTop_toTopOf="@+id/donate_button"
      app:srcCompat="@drawable/launcher_coupon" />

  <androidx.appcompat.widget.AppCompatImageView
      android:id="@+id/right_back2"
      android:layout_width="405dp"
      android:layout_height="fill_parent"
      android:scaleType="fitXY"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="1.0"
      app:layout_constraintStart_toStartOf="@+id/videoView"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="1.0"
      app:layout_constraintWidth_percent="0.45"
      app:srcCompat="@drawable/launcher_start_game" />

  <androidx.appcompat.widget.AppCompatButton
      android:id="@+id/button_settings"
      android:layout_width="@dimen/_30sdp"
      android:layout_height="@dimen/_30sdp"
      android:layout_marginTop="36dp"
      android:background="@drawable/launcher_main_settings"
      app:layout_constraintBottom_toBottomOf="@+id/right_back2"
      app:layout_constraintEnd_toEndOf="@+id/right_back2"
      app:layout_constraintHorizontal_bias="0.043"
      app:layout_constraintStart_toStartOf="@+id/right_back2"
      app:layout_constraintTop_toTopOf="@+id/right_back2"
      app:layout_constraintVertical_bias="0.026" />

  <TextView
      android:id="@+id/online_help2"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="36dp"
      android:fontFamily="@font/montserrat_bold"
      android:letterSpacing="0.2"
      android:text="СЕЙЧАС\nОНЛАЙН"
      android:textColor="#424242"
      android:textSize="@dimen/_10sdp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.875"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

  <TextView
      android:id="@+id/online_text2"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="32dp"
      android:fontFamily="@font/akrobat_bold"
      android:gravity="center"
      android:text="40"
      android:textColor="#424242"
      android:textSize="@dimen/_20sdp"
      android:textStyle="bold"
      app:layout_constraintEnd_toEndOf="@+id/online_help2"
      app:layout_constraintHorizontal_bias="0.484"
      app:layout_constraintStart_toStartOf="@+id/online_help2"
      app:layout_constraintTop_toTopOf="@+id/online_help2" />

  <FrameLayout
      android:id="@+id/edit_container"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      tools:ignore="MissingConstraints"/>

  <EditText
      android:id="@+id/edittextname"
      android:layout_width="114dp"
      android:layout_height="36dp"
      android:layout_margin="30.0dip"
      android:layout_marginStart="28dp"
      android:background="@drawable/launcher_main_edit_text_bg"
      android:digits="abcdefghijklmnopqrstuvwxyz_ABCDEFGHIJKLMNOPQRSTUVWXYZ"
      android:fontFamily="@font/montserrat_regular"
      android:gravity="center"
      android:hint="Nick_Name"
      android:imeOptions="actionDone|flagNoFullscreen"
      android:inputType="textCapSentences"
      android:maxLength="23"
      android:paddingStart="8.0dip"
      android:paddingEnd="8.0dip"
      android:singleLine="true"
      android:textColor="@color/white"
      android:textColorHint="@color/white25"
      android:textSize="11.0sp"
      android:textStyle="italic"
      android:visibility="invisible"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintVertical_bias="0.072" />

  <ImageButton
      android:id="@id/ib_info"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:layout_marginStart="16dp"
      android:background="@drawable/launcher_red_buttons_bg"
      android:contentDescription="info"
      android:src="@drawable/launcher_main_info_ic"
      android:visibility="invisible"
      app:layout_constraintBottom_toBottomOf="@id/edittextname"
      app:layout_constraintStart_toEndOf="@id/edittextname"
      app:layout_constraintTop_toTopOf="@id/edittextname"
      app:layout_constraintVertical_bias="1.0" />

  <androidx.appcompat.widget.AppCompatButton
      android:id="@id/button_play"
      android:layout_width="163dp"
      android:layout_height="47dp"
      android:layout_margin="30.0dip"
      android:layout_marginEnd="52dp"
      android:background="#008F6C6C"
      android:drawablePadding="10.0dip"
      android:fontFamily="@font/montserrat_bold"
      android:gravity="center"
      android:paddingStart="28.0dip"
      android:paddingEnd="36.0dip"
      android:textColor="@color/white"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintHorizontal_bias="0.931"
      app:layout_constraintStart_toStartOf="@+id/right_back2"
      app:layout_constraintTop_toTopOf="@+id/right_back2"
      app:layout_constraintVertical_bias="0.955" />

  <TextView
      android:id="@id/text_view_info_about_nickname"
      android:layout_width="231dp"
      android:layout_height="94dp"
      android:layout_marginTop="8.0dip"
      android:background="@drawable/launcher_main_info_bg"
      android:gravity="center"
      android:importantForAccessibility="no"
      android:paddingStart="8.0dip"
      android:paddingEnd="8.0dip"
      android:text="• формат ввода: Nick_Name\n• допустимая длина никнейма 3-23 символов\n• в никнейме запрещены оскорбительные\nи нецензурные слова\n• никнейм должен содержать только латиницу\n• запрещено использование цифр и символов"
      android:textColor="@color/white"
      android:textSize="10.0sp"
      android:textStyle="italic"
      android:visibility="invisible"
      app:layout_constraintStart_toStartOf="@id/ib_info"
      app:layout_constraintTop_toBottomOf="@id/ib_info" />

  <ProgressBar
      android:id="@id/progress_bar"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:indeterminateDrawable="@drawable/progressbar_custom"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
